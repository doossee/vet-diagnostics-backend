# ================================
# Multi-stage Production Dockerfile
# ================================

# Stage 1: Build (also used as the "migrate" one-shot image — it keeps the
# prisma CLI, the multi-file schema and prisma.config.ts)
FROM node:22-alpine AS builder

WORKDIR /app

# Copy dependency files
COPY package*.json yarn.lock ./

# Install all dependencies (including dev dependencies for build)
RUN yarn install --frozen-lockfile

# Copy source code
COPY . .

# Dummy DATABASE_URL so prisma.config.ts can be evaluated during generate
# (the real URL is injected at runtime for `prisma migrate deploy`).
ENV DATABASE_URL="postgresql://dummy:dummy@localhost:5432/dummy?schema=public"

# Generate Prisma Client. No --schema flag: prisma.config.ts points at the
# multi-file folder (prisma/schema) so every *.prisma file is loaded.
# Output goes to src/generated/prisma, which `yarn build` compiles into dist.
RUN npx prisma generate

# Build application (compiles src + src/generated/prisma -> dist)
RUN yarn build

# ================================
# Stage 2: Production
# ================================
FROM node:22-alpine AS production

WORKDIR /app

ENV NODE_ENV=production

# Install production dependencies only
COPY package*.json yarn.lock ./
RUN yarn install --frozen-lockfile --production && yarn cache clean

# Copy built application from builder. The generated Prisma client is part of
# dist (dist/generated/prisma) and uses the @prisma/adapter-pg driver adapter,
# so no query-engine binary / node_modules/.prisma copy is needed.
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/prisma ./prisma

# Create uploads directory
RUN mkdir -p /app/uploads

# Create non-root user for security
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nestjs -u 1001 && \
    chown -R nestjs:nodejs /app

# Switch to non-root user
USER nestjs

# Expose application port
EXPOSE 3000

# Health check (exits non-zero on connection error too)
HEALTHCHECK --interval=30s --timeout=3s --start-period=40s --retries=3 \
    CMD node -e "require('http').get('http://localhost:3000/health',(r)=>{process.exit(r.statusCode===200?0:1)}).on('error',()=>process.exit(1))"

# Start application
CMD ["node", "dist/main"]
