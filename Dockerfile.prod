# ================================
# Multi-stage Production Dockerfile
# ================================

# Stage 1: Build (also used as the "migrate" one-shot image — it keeps the
# prisma CLI, the multi-file schema and prisma.config.ts)
FROM node:22-alpine AS builder

WORKDIR /app

# Copy dependency files
COPY package*.json yarn.lock ./

# Install all dependencies (including dev dependencies for build)
RUN yarn install --frozen-lockfile

# Copy source code
COPY . .

# Dummy DATABASE_URL so prisma.config.ts can be evaluated during generate
# (the real URL is injected at runtime for `prisma migrate deploy`).
ENV DATABASE_URL="postgresql://dummy:dummy@localhost:5432/dummy?schema=public"

# Generate Prisma Client. No --schema flag: prisma.config.ts points at the
# multi-file folder (prisma/schema) so every *.prisma file is loaded.
# Output goes to src/generated/prisma, which `yarn build` compiles into dist.
RUN npx prisma generate

# Build application (compiles src + src/generated/prisma -> dist)
RUN yarn build

# ================================
# Stage 2: Production
# ================================
FROM node:22-alpine AS production

WORKDIR /app
ENV NODE_ENV=production
# disable Prisma's update check (no runtime network call / cache writes)
ENV CHECKPOINT_DISABLE=1

# Create the non-root user FIRST so we can COPY --chown and avoid a
# `chown -R /app`, which would duplicate node_modules into its own layer
# (~430 MB of waste). node_modules is world-readable, so the app reads the
# root-owned deps fine; only ./uploads needs to be writable.
RUN addgroup -g 1001 -S nodejs && adduser -S nestjs -u 1001

# Production dependencies only. `prisma` (CLI) is a production dependency and
# `dotenv` is required by prisma.config.ts, so the container can run
# `prisma migrate deploy` itself at startup — no separate migrate container.
COPY package*.json yarn.lock ./
RUN yarn install --frozen-lockfile --production && yarn cache clean

# Built app + Prisma schema/migrations/config (all needed by `migrate deploy`).
# The generated Prisma client lives in dist (dist/generated/prisma) and uses the
# @prisma/adapter-pg driver adapter — no query-engine binary copy needed.
COPY --from=builder --chown=nestjs:nodejs /app/dist ./dist
COPY --from=builder --chown=nestjs:nodejs /app/prisma ./prisma
COPY --from=builder --chown=nestjs:nodejs /app/prisma.config.ts ./prisma.config.ts
COPY --chown=nestjs:nodejs docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh \
    && mkdir -p /app/uploads && chown nestjs:nodejs /app/uploads

USER nestjs
EXPOSE 3000

# Health check (exits non-zero on connection error too). Longer start period to
# cover `migrate deploy` running before the server binds.
HEALTHCHECK --interval=30s --timeout=3s --start-period=60s --retries=3 \
    CMD node -e "require('http').get('http://localhost:3000/health',(r)=>{process.exit(r.statusCode===200?0:1)}).on('error',()=>process.exit(1))"

# Apply DB migrations, then start the app
ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["node", "dist/main"]
