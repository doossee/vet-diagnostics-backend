model Disease {
    id String @id @default(uuid()) @db.Uuid

    name_ru String @db.VarChar(100)
    name_uz String @db.VarChar(100)

    diseaseCategoryId String      @map("type_id") @db.Uuid
    diseaseCategory   DiseaseCategory @relation(fields: [diseaseCategoryId], references: [id], onDelete: Restrict)

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    animals Animal[]

    @@index([diseaseCategoryId])
    @@map("diseases")
}

model DiseaseCategory {
    id String @id @default(uuid()) @db.Uuid

    name_ru String @db.VarChar(100)
    name_uz String @db.VarChar(100)

    parentId String?      @map("parent_id") @db.Uuid
    parent   DiseaseCategory? @relation("DiseaseCategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)

    diseases Disease[]
    children DiseaseCategory[] @relation("DiseaseCategoryHierarchy")

    @@map("disease_types")
}
