// =============================================================================
// AUTH — Users, Vet Profiles, Farmer Profiles
// =============================================================================

model User {
  id String @id @default(uuid()) @db.Uuid

  // Authentication
  username String @unique @db.VarChar(255)
  password String @db.VarChar(255)

  // Profile
  firstName String  @map("first_name") @db.VarChar(255)
  lastName  String? @map("last_name") @db.VarChar(255)
  email     String? @unique @db.VarChar(255)
  phone     String? @unique @db.VarChar(20)
  avatar    String? @db.VarChar(500)

  gender    UserGender?
  birthDate DateTime?   @map("birth_date") @db.Date
  address   String?     @db.VarChar(255)

  role UserRole @default(SUPER_ADMIN)

  districtId String   @map("district_id") @db.Uuid
  district   District @relation(fields: [districtId], references: [id], onDelete: Restrict)

  // Refresh Token (for token rotation)
  refreshTokenHash String?   @map("refresh_token_hash") @db.VarChar(255)
  tokenExpiresAt   DateTime? @map("token_expires_at") @db.Timestamp(6)

  // Status
  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at") @db.Timestamp(6)

  // Audit
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  veterinarianProfile VetProfile?
  farmerProfile       FarmerProfile?
  feedbacks           Feedback[]

  @@index([username])
  @@index([role])
  @@index([districtId])
  @@map("users")
}

enum UserRole {
  SUPER_ADMIN // System administrator - full system access
  ADMIN // admin
  VETERINARIAN // veterinar
  FARMER // chorvador
}

enum UserGender {
  MALE // erkak
  FEMALE // ayol
}

model VetProfile {
  id String @id @map("user_id") @db.Uuid

  user User @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  licenseNumber  String? @unique @map("license_number") @db.VarChar(50)
  specialization String? @map("specialization") @db.VarChar(100)
  experience     Int?    @default(0)

  farmers         FarmerProfile[]
  medicalSessions MedicalSession[]
  feedbacks       Feedback[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([licenseNumber])
  @@map("veterinarians")
}

model FarmerProfile {
  id String @id @map("user_id") @db.Uuid

  user User @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  veterinarianId String     @map("veterinarian_id") @db.Uuid
  veterinarian   VetProfile @relation(fields: [veterinarianId], references: [id], onDelete: Restrict)

  farmName String? @map("farm_name") @db.VarChar(100)
  farmSize Float?  @map("farm_size")

  animals Animal[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([veterinarianId])
  @@map("farmers")
}
