// Clinical / General Inspection
// Clinical / General Inspection
model ClinicalExam {
  id String @id @default(uuid()) @db.Uuid

  animalId String @map("animal_id") @db.Uuid
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  // --- General ---
  pulse           Int? // puls
  rumination      Int? // ruminatsiya
  temperature     Float? // temperatura
  respiratoryRate Float? @map("respiratory_rate") // nafas soni

  // --- Habitus ---
  bodyType     BodyType?     @map("body_type") // jussasi
  obesity      ObesityType? // semizligi
  bodyPosition BodyPosition? @map("body_position") // holati
  constitution Constitution? @map("constitution") // tana tuzilishi (konstitutsiyasi)
  temperament  Temperament?  @map("temperament") // mijozi

  // --- Skin Cover (Teri qoplamasi) ---
  wool     WoolType?    @map("wool") // jun
  down     DownType?    @map("down") // tivit
  hair     HairType?    @map("hair") // tuk
  feathers FeatherType? @map("feathers") // par, pat

  // --- Skin (Teri) ---
  skinColor       SkinColor?      @map("skin_color") // rangi
  skinHumidity    SkinHumidity?   @map("skin_humidity") // namligi
  skinSmell       String?         @map("skin_smell") // hidi (text field as no specific enums provided, or maybe boolean?) -> Document says "Hidi" with empty space, assuming text or presence.
  skinTemp        SkinTemp?       @map("skin_temp") // mahalliy harorati
  skinSurface     String?         @map("skin_surface") // yuzasi (text)
  skinElasticity  SkinElasticity? @map("skin_elasticity") // elastikligi
  skinSensitivity String?         @map("skin_sensitivity") // sezuvchanligi (text)
  skinPain        String?         @map("skin_pain") // og'riq sezishi (text)

  // --- Lymph Nodes (Limfa tugunlari) ---
  lymphSize        LymphSize?        @map("lymph_size") // kattaligi
  lymphShape       LymphShape?       @map("lymph_shape") // shakli
  lymphSurface     LymphSurface?     @map("lymph_surface") // yuza xususiyati
  lymphConsistency LymphConsistency? @map("lymph_consistency") // konsistensiyasi
  lymphTemp        LymphTemp?        @map("lymph_temp") // mahalliy harorati
  lymphPain        LymphPain?        @map("lymph_pain") // og'riq sezishi
  lymphMobility    LymphMobility?    @map("lymph_mobility") // harakatchanligi

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("clinical_analyses")
}

// --- Enums ---

enum BodyType {
  STRONG // Kuchli jussali
  MEDIUM // O'rtacha jussali
  WEAK // Kuchsiz jussali
}

enum ObesityType {
  HIGH // Yaxshi, yuqori semiz
  MEDIUM // O'rtacha semiz
  LOW // O'rtadan past semiz
  CACHEXIA // Kaxeksiya
}

enum BodyPosition {
  NATURAL // Tabiiy
  FORCED_STANDING // Majburiy tik turgan
  FORCED_LYING // Majburiy yotgan
  FORCED_SITTING // Majburiy o’tirgan
  NON_THERAPEUTIC // Tabiiy bo’lmagan holat
  INVOLUNTARY // Ixtiyorsiz harakatlar
  MANEGE // Monejli harakat
  CIRCULAR // Aylanma harakat
  FORWARD // Oldinga qarab harakat
  BACKWARD // Orqaga qarab harakat
  ROLLING // Ag’anab yotgan joyidagi harakat
}

enum Constitution {
  LOOSE // YShX (Yumshoq?)
  DENSE // MShH (Mustahkam?)
  HORSES // Otlar (Specific type?)
  BIRDS // Parrandalarda
}

enum Temperament {
  MELANCHOLIC // Melanxolik
  PHLEGMATIC // Flegmatik
  // Document only listed these two, but usually there are 4. Keeping strictly to doc.
}

enum WoolType {
  EVEN // Bir tekis
  UNEVEN // Bir tekis emas
  LYING_FLAT // Teriga yotib turibdi
  SHINY // Yaltiroq
  MATTE // Yaltiroq emas (Xira?)
  NOT_FALLING // Tushmaydi
  DISHEVELED // Hurpaygan
  MATTED // Bir biriga yopishgan
  BALD_PATCHES // Terining ayrim joylarida junlar tushgan
  THICK // Qalin
  SPARSE // Siyrak
  PHYSIOLOGICAL_MOLT // Fiziologik tullash
  PATHOLOGICAL_MOLT // Patologik tullash
  FALLING // Jun tushayapti
  NOT_FALLING_OUT // Jun tushmayapti
}

enum DownType {
  DENSE // Zich
  SPARSE // Siyrak
  NONE // Yo’q
  SOFT // Yumshoq
  SMOOTH // Silliq
  MATTE // Xira
  SHINY // Yaltiroq
  DRY // Quruq
  DUSTY // Chang bosgan
  EVEN // Bir tekis
  WHITE // Oq rangli
  GRAY // Kulrang
  YELLOWISH // Sarg’aygan
  DARK // Qoramtir
  MOIST // Nam
}

enum HairType {
  COARSE // Dag’al
  SPARSE // Siyrak
}

enum FeatherType {
  SHINY // Yaltiroq
  MATTE // Xira
  FULL // To’liq
  FALLEN // To’kilgan
  BROKEN // Siniq
}

enum SkinColor {
  PALE_VIOLET // Och binafsha
  PALE // Oqargan
  RED // Qizargan
  BLUE // Ko’kargan
  YELLOW // Sarg’aygan
}

enum SkinHumidity {
  MODERATE // O’rtacha nam
  HYPERHIDROSIS // Gipergidroz
  LOCAL_SWEAT // Mahalliy terlagan
  DRY // Quruq – angidoz
}

enum SkinTemp {
  GENERAL_HIGH // Teri harorati umumiy ko’tarilgan
  LOCAL_HIGH // Teri harorati mahalliy ko’tarilgan
  GENERAL_LOW // Teri harorati umumiy pasaygan
  LOCAL_LOW // Teri harorati mahalliy pasaygan
  UNEVEN // Teri harorati har xil
}

enum SkinElasticity {
  ELASTIC // elastik
  REDUCED // teri elastikgi kamaygan
  NONE // teri elastikligi umuman yo’q
}

enum LymphSize {
  NORMAL // Kattarmagan
  ENLARGED // Kattargan
}

enum LymphShape {
  FLAT // Yassi
  ROUND // Dumaloq
  ENLARGED // Kattargan (Duplicate concept but in shape list?)
  SWOLLEN // Shishgan
}

enum LymphSurface {
  SMOOTH // Silliq
  ROUGH // G’adir-budir
}

enum LymphConsistency {
  DENSE // Zich
  SOFT // Bilqillagan
  SPECIFIC // O’ziga xos
}

enum LymphTemp {
  NORMAL // O’rtacha
  ELEVATED // Oshgan
}

enum LymphPain {
  PAINLESS // Og’riqsiz
  PAINFUL // Og’riqli
}

enum LymphMobility {
  MOBILE // Harakatchan
  LOW_MOBILITY // Kam harakatchan
}

// Blood Analysis
model BloodExam {
  id String @id @default(uuid()) @db.Uuid

  animalId String? @map("animal_id") @db.Uuid
  animal   Animal? @relation(fields: [animalId], references: [id], onDelete: Cascade)

  // Qonning morfologik tekshirishlari / Морфологическое исследование крови / Blood Morphological Analysis
  coe              Float? // СОЭ / COE / скорость оседания эритроцитов
  erythrocyteCount Float? @map("erythrocyte_count") // эритроциты / eritrositlar soni
  leukocyteCount   Float? @map("leukocyte_count") // лейкоциты / leykotsitlar soni
  thrombocyteCount Float? @map("thrombocyte_count") // тромбоциты / trombotsitlar soni
  hemoglobin       Float? // гемоглобин / gemoglobin
  glutathione      Float? // глутатион / glutation
  waterPercentage  Float? @map("water_percentage") // вода % / suv foizi
  dryResidue       Float? @map("dry_residue") // сухой остаток % / quruq qoldiq foizi

  // Qon Serum tekshiruvi / Исследование сыворотки крови / Blood Serum Analysis
  totalProtein      Float? @map("total_protein") // zardobdagi umumiy oqsil — g/l / общий белок в сыворотке
  totalCalcium      Float? @map("total_calcium") // umumiy kalsiy — mmol/l / общий кальций
  organicPhosphorus Float? @map("organic_phosphorus") // organik fosfor — mmol/l / органический фосфор
  albumin           Float? // albuminlar — % / альбумины
  alphaGlobulin     Float? @map("alpha_globulin") // alfa-globulinlar — % / альфа-глобулины
  betaGlobulin      Float? @map("beta_globulin") // beta-globulinlar — % / бета-глобулины
  gammaGlobulin     Float? @map("gamma_globulin") // gamma-globulinlar — % / гамма-глобулины
  residualNitrogen  Float? @map("residual_nitrogen") // qoldiq azot — mmol/l / остаточный азот
  urea              Float? // mochevina (karbamid) — mmol/l / мочевина (карбамид)
  uricAcid          Float? @map("uric_acid") // moche kislotasi — mmol/l / мочевая кислота
  creatine          Float? // kreatin — mmol/l / креатин
  creatinine        Float? // kreatinin — mkmol/l / креатинин
  alkalineReserve   Float? @map("alkaline_reserve") // ishqoriy zaxira — % СО₂ / щелочной резерв
  glucose           Float? // glyukoza — mmol/l / глюкоза
  ketoneBodies      Float? @map("ketone_bodies") // keton tanachalari — g/l / кетоновые тела
  totalBilirubin    Float? @map("total_bilirubin") // umumiy bilirubin — mkmol/l / общий билирубин
  directBilirubin   Float? @map("direct_bilirubin") // to'g'ri bilirubin — mkmol/l / прямой билирубин
  totalCholesterol  Float? @map("total_cholesterol") // umumiy xolesterin — mmol/l / общий холестерин
  totalLipids       Float? @map("total_lipids") // umumiy lipidlar — g/l / общие липиды
  phospholipids     Float? // fosfolipidlar — g/l / фосфолипиды
  lacticAcid        Float? @map("lactic_acid") // sutch (laktat) kislotasi — mmol/l / молочная кислота
  pyruvicAcid       Float? @map("pyruvic_acid") // piruvinuz (piruvat) kislotasi — mmol/l / пировиноградная кислота
  citricAcid        Float? @map("citric_acid") // limon kislotasi — mmol/l / лимонная кислота
  carotene          Float? // karotin — mkmol/l / каротин
  vitaminA          Float? @map("vitamin_a") // A vitamini — mkmol/l / витамин A
  vitaminB          Float? @map("vitamin_b") // B vitamini — mkmol/l / витамин B
  vitaminC          Float? @map("vitamin_c") // C vitamini — mkmol/l / витамин C

  conclusion String? @db.Text() // заключение / xulosa / conclusion

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("blood_analyses")
}

model UrineExam {
  id String @id @default(uuid()) @db.Uuid

  animalId String? @map("animal_id") @db.Uuid
  animal   Animal? @relation(fields: [animalId], references: [id], onDelete: Cascade)

  urineColorId String?     @map("urine_color_id") @db.Uuid
  urineColor   UrineColor? @relation(fields: [urineColorId], references: [id], onDelete: Restrict)

  // Макроскопическое исследование / Makroskopik tekshiruv
  amount Float? // количество / miqdor

  urineClarityId String?       @map("urine_clarity_id") @db.Uuid
  urineClarity   UrineClarity? @relation(fields: [urineClarityId], references: [id], onDelete: Restrict)

  urineConsistencyId String?           @map("urine_consistency_id") @db.Uuid
  urineConsistency   UrineConsistency? @relation(fields: [urineConsistencyId], references: [id], onDelete: Restrict)

  urineSmellId String?     @map("urine_smell_id") @db.Uuid
  urineSmell   UrineSmell? @relation(fields: [urineSmellId], references: [id], onDelete: Restrict)

  // Лабораторное исследование / Laborator tekshiruv
  ph           Float? // среда (pH)
  acetone      Float? // кетоновые тела (ацетон)
  protein      Float? // белок
  bilirubin    Float? // билирубин
  urobilinogen Float? // уробилиноген
  sugar        Float? // сахар

  // Микроскопическое исследование / Mikroskopik tekshiruv
  leukocytes      Float? // лейкоциты / leykosit
  epithelium      Float? // эпителий / epiteliy
  microbialBodies Float? @map("microbial_bodies") // микробные тела / mikrob tanachalar
  erythrocytes    Float? // эритроциты / eritrosit
  saltCrystals    Float? @map("salt_crystals") // кристаллы солей / tuz kristallari

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("urine_analyses")
}

