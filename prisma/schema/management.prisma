// =============================================================================
// MANAGEMENT — Regions, Districts, Vet Stations
// =============================================================================

model Region {
  id Int @id @default(autoincrement())

  nameRu String @unique @map("name_ru") @db.VarChar(255)
  nameUz String @unique @map("name_uz") @db.VarChar(255)

  districts District[]

  @@map("regions")
}

model District {
  id String @id @default(uuid()) @db.Uuid

  nameRu String @map("name_ru") @db.VarChar(255)
  nameUz String @map("name_uz") @db.VarChar(255)

  regionId Int    @map("region_id")
  region   Region @relation(fields: [regionId], references: [id], onDelete: Cascade)

  users       User[]
  vetStations VetStation[]

  @@index([regionId])
  @@map("districts")
}

model VetStation {
  id String @id @default(uuid()) @db.Uuid

  nameRu  String @map("name_ru") @db.VarChar(255)
  nameUz  String @map("name_uz") @db.VarChar(255)
  address String @db.VarChar(255)

  districtId String   @map("district_id") @db.Uuid
  district   District @relation(fields: [districtId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([districtId])
  @@map("vet_stations")
}
