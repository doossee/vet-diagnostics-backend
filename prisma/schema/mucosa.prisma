
model MucosaAnalysis {
  id String @id @default(uuid()) @db.Uuid

  mucosaType MucosaType @map("mucosa_type")

  animalId String? @map("animal_id")
  animal   Animal? @relation(fields: [animalId], references: [id], onDelete: Cascade)

  mucosaAppearanceId String?           @map("mucosa_appearance_id") @db.Uuid
  mucosaAppearance   MucosaAppearance? @relation(fields: [mucosaAppearanceId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("mucosa_analyses")
}

model MucosaAppearance {
  id String @id @default(uuid()) @db.Uuid

  name_ru String @db.VarChar(255)
  name_uz String @db.VarChar(255)

  mucosaType MucosaType @map("mucosa_type")

  animalTypeId String     @map("animal_type_id") @db.Uuid
  animalType   AnimalType @relation(fields: [animalTypeId], references: [id], onDelete: Restrict)

  mucosaAnalyses MucosaAnalysis[]

  @@map("mucosa_appearances")
}

enum MucosaType {
  ORAL // оральный (ротовой) / og'iz
  NASAL // назальный (носовой) / burun
  OCULAR // окулярный (глазной) / ko'z
  REPRODUCTIVE // репродуктивный / reproduktiv organ
}