// =============================================================================
// FECES EXAM & LOOKUP TABLES
// =============================================================================

model FecesExam {
  id String @id @default(uuid()) @db.Uuid

  animalId String? @map("animal_id") @db.Uuid
  animal   Animal? @relation(fields: [animalId], references: [id], onDelete: Cascade)

  sessionId String?         @unique @map("session_id") @db.Uuid
  session   MedicalSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  fecesColorId String?     @map("feces_color_id") @db.Uuid
  fecesColor   FecesColor? @relation(fields: [fecesColorId], references: [id], onDelete: Restrict)

  fecesSmellId String?     @map("feces_smell_id") @db.Uuid
  fecesSmell   FecesSmell? @relation(fields: [fecesSmellId], references: [id], onDelete: Restrict)

  fecesConsistencyId String?           @map("feces_consistency_id") @db.Uuid
  fecesConsistency   FecesConsistency? @relation(fields: [fecesConsistencyId], references: [id], onDelete: Restrict)

  fecesFormId String?    @map("feces_form_id") @db.Uuid
  fecesForm   FecesForm? @relation(fields: [fecesFormId], references: [id], onDelete: Restrict)

  amount         Float?
  undigestedFood Float? @map("undigested_food")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([animalId])
  @@index([fecesColorId])
  @@index([fecesSmellId])
  @@index([fecesConsistencyId])
  @@index([fecesFormId])
  @@map("feces_analyses")
}

// =============================================================================
// FECES LOOKUP TABLES
// =============================================================================

model FecesColor {
  id String @id @default(uuid()) @db.Uuid

  name         Json @db.JsonB
  numericValue Int  @map("numeric_value")

  animalTypeId String     @map("animal_type_id") @db.Uuid
  animalType   AnimalType @relation(fields: [animalTypeId], references: [id], onDelete: Restrict)

  fecesAnalyses FecesExam[]

  @@index([animalTypeId])
  @@map("feces_colors")
}

model FecesSmell {
  id String @id @default(uuid()) @db.Uuid

  name         Json @db.JsonB
  numericValue Int  @map("numeric_value")

  animalTypeId String     @map("animal_type_id") @db.Uuid
  animalType   AnimalType @relation(fields: [animalTypeId], references: [id], onDelete: Restrict)

  fecesAnalyses FecesExam[]

  @@index([animalTypeId])
  @@map("feces_smells")
}

model FecesConsistency {
  id String @id @default(uuid()) @db.Uuid

  name         Json @db.JsonB
  numericValue Int  @map("numeric_value")

  animalTypeId String     @map("animal_type_id") @db.Uuid
  animalType   AnimalType @relation(fields: [animalTypeId], references: [id], onDelete: Restrict)

  fecesAnalyses FecesExam[]

  @@index([animalTypeId])
  @@map("feces_consistencies")
}

model FecesForm {
  id String @id @default(uuid()) @db.Uuid

  name         Json @db.JsonB
  numericValue Int  @map("numeric_value")

  animalTypeId String     @map("animal_type_id") @db.Uuid
  animalType   AnimalType @relation(fields: [animalTypeId], references: [id], onDelete: Restrict)

  fecesAnalyses FecesExam[]

  @@index([animalTypeId])
  @@map("feces_forms")
}
