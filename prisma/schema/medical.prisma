
model Disease {
    id String @id @default(uuid()) @db.Uuid

    name_ru String @db.VarChar(100)
    name_uz String @db.VarChar(100)

    diseaseCategoryId String      @map("type_id") @db.Uuid
    diseaseCategory   DiseaseCategory @relation(fields: [diseaseCategoryId], references: [id], onDelete: Restrict)

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    animals Animal[]

    @@index([diseaseCategoryId])
    @@map("diseases")
}

model DiseaseCategory {
    id String @id @default(uuid()) @db.Uuid

    name_ru String @db.VarChar(100)
    name_uz String @db.VarChar(100)

    parentId String?      @map("parent_id") @db.Uuid
    parent   DiseaseCategory? @relation("DiseaseCategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)

    diseases Disease[]
    children DiseaseCategory[] @relation("DiseaseCategoryHierarchy")

    @@map("disease_types")
}

model Prophylaxis {
    id String @id @default(uuid()) @db.Uuid

    type ProphylaxisType

    animalId String @map("animal_id") @db.Uuid
    animal   Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

    itemId String           @map("item_id") @db.Uuid
    item   ProphylaxisItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

    // Optional detail (strain for vaccine, preparation for deworming)
    detailId String?             @map("detail_id") @db.Uuid
    detail   ProphylaxisDetail? @relation(fields: [detailId], references: [id], onDelete: Restrict)

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@index([animalId])
    @@index([type])
    @@map("prophylactic_records")
}

model ProphylaxisItem {
    id String @id @default(uuid()) @db.Uuid

    name_ru String @db.VarChar(255)
    name_uz String @db.VarChar(255)

    type ProphylaxisType

    records Prophylaxis[]
    details ProphylaxisDetail[]

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@index([type])
    @@map("prophylactic_items")
}

model ProphylaxisDetail {
    id String @id @default(uuid()) @db.Uuid

    name_ru String @db.VarChar(255)
    name_uz String @db.VarChar(255)

    itemId String           @map("item_id") @db.Uuid
    item   ProphylaxisItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

    records Prophylaxis[]

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@index([itemId])
    @@map("prophylactic_details")
}

enum ProphylaxisType {
    VACCINE
    IMMUNIZATION
    DEWORMING
}
