// =============================================================================

model BodyType {
  id           String         @id @default(uuid()) @db.Uuid
  nameRu       String         @map("name_ru") @db.VarChar(255)
  nameUz       String         @map("name_uz") @db.VarChar(255)
  numericValue Int            @unique @map("numeric_value")
  clinicalExams ClinicalExam[]

  @@map("body_types")
}

