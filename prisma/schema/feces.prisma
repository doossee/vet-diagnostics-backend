// Feces Analysis Models and Enums

enum FecesAnalysisType {
  MACROSCOPIC // макроскопический / makroskopik
  MICROSCOPIC // микроскопический / mikroskopik
}

model FecesAnalysis {
    id String @id @default(uuid()) @db.Uuid

    animalId String? @map("animal_id")
    animal   Animal? @relation(fields: [animalId], references: [id], onDelete: Cascade)

    fecesColorId String?     @map("feces_color_id") @db.Uuid
    fecesColor   FecesColor? @relation(fields: [fecesColorId], references: [id], onDelete: Restrict)

    // Макроскопические исследования / Makroskopik tekshiruv
    fecesSmellId String?      @map("feces_smell_id") @db.Uuid
    fecesSmell   FecesSmell?  @relation(fields: [fecesSmellId], references: [id], onDelete: Restrict)
    
    fecesConsistencyId String?            @map("feces_consistency_id") @db.Uuid
    fecesConsistency   FecesConsistency?  @relation(fields: [fecesConsistencyId], references: [id], onDelete: Restrict)
    
    fecesFormId String?     @map("feces_form_id") @db.Uuid
    fecesForm   FecesForm?  @relation(fields: [fecesFormId], references: [id], onDelete: Restrict)
    
    amount             Float? // количество / miqdor
    undigestedFood     Float? @map("undigested_food") // количество непереваренной пищи / hazm bo'lmagan ovqat miqdori

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@map("feces_analyses")
}

model FecesColor {
    id String @id @default(uuid()) @db.Uuid

    name_ru String @db.VarChar(255)
    name_uz String @db.VarChar(255)

    animalTypeId String     @map("animal_type_id") @db.Uuid
    animalType   AnimalType @relation(fields: [animalTypeId], references: [id], onDelete: Restrict)

    fecesAnalyses FecesAnalysis[]
    
    
    @@map("feces_colors")
}

model FecesSmell {
    id String @id @default(uuid()) @db.Uuid

    name_ru String @db.VarChar(255)
    name_uz String @db.VarChar(255)

    animalTypeId String     @map("animal_type_id") @db.Uuid
    animalType   AnimalType @relation(fields: [animalTypeId], references: [id], onDelete: Restrict)

    fecesAnalyses FecesAnalysis[]
    
    @@map("feces_smells")
}

model FecesConsistency {
    id String @id @default(uuid()) @db.Uuid

    name_ru String @db.VarChar(255)
    name_uz String @db.VarChar(255)

    animalTypeId String     @map("animal_type_id") @db.Uuid
    animalType   AnimalType @relation(fields: [animalTypeId], references: [id], onDelete: Restrict)

    fecesAnalyses FecesAnalysis[]
    
    @@map("feces_consistencies")
}

model FecesForm {
    id String @id @default(uuid()) @db.Uuid

    name_ru String @db.VarChar(255)
    name_uz String @db.VarChar(255)

    animalTypeId String     @map("animal_type_id") @db.Uuid
    animalType   AnimalType @relation(fields: [animalTypeId], references: [id], onDelete: Restrict)

    fecesAnalyses FecesAnalysis[]
    
    @@map("feces_forms")
}
