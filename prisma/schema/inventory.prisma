// =============================================================================
// INVENTORY — Animals, Types, Breeds, Colors, Sexes
// =============================================================================

model AnimalSex {
  id           String       @id @default(uuid()) @db.Uuid
  name         Json         @db.JsonB
  numericValue Int          @unique @map("numeric_value")
  animals      Animal[]
  animalTypes  AnimalType[] @relation("AnimalTypeSex")

  @@map("animal_sexes")
}

model Animal {
  id String @id @default(uuid()) @db.Uuid

  arrivalDate DateTime @map("arrival_date")

  ageYears  Int  @default(0) @map("age_years") @db.SmallInt
  ageMonths Int  @default(0) @map("age_months") @db.SmallInt
  sexId String?    @map("sex_id") @db.Uuid
  sex   AnimalSex? @relation(fields: [sexId], references: [id], onDelete: Restrict)

  animalNameCode String @unique @map("animal_name_code") @db.VarChar(50)

  farmerId String?        @map("farmer_id") @db.Uuid
  farmer   FarmerProfile? @relation(fields: [farmerId], references: [id], onDelete: Restrict)

  animalTypeId String     @map("animal_type_id") @db.Uuid
  animalType   AnimalType @relation(fields: [animalTypeId], references: [id], onDelete: Restrict)

  animalBreedId String @map("animal_breed_id") @db.Uuid
  animalBreed   Breed  @relation(fields: [animalBreedId], references: [id], onDelete: Restrict)

  animalColorId String @map("color_id") @db.Uuid
  animalColor   Color  @relation(fields: [animalColorId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  vaccines         Prophylaxis[]
  diseases         Disease[]
  urineAnalyses    UrineExam[]
  fecesAnalyses    FecesExam[]
  mucosaAnalyses   MucosaExam[]
  bloodAnalyses    BloodExam[]
  clinicalAnalyses ClinicalExam[]
  medicalSessions  MedicalSession[]
  anomalyAlerts    AnomalyAlert[]

  @@index([farmerId])
  @@index([animalTypeId])
  @@index([animalBreedId])
  @@index([animalColorId])
  @@index([sexId])
  @@map("animals")
}

model AnimalType {
  id String @id @default(uuid()) @db.Uuid

  name     Json    @db.JsonB
  modelKey String? @unique @map("model_key")

  // Optional sex constraint (e.g. bull = male only, heifer = female only)
  sexId String?    @map("sex_id") @db.Uuid
  sex   AnimalSex? @relation("AnimalTypeSex", fields: [sexId], references: [id], onDelete: Restrict)

  // Optional age range in total months (e.g. calf = 0–11 months)
  minAgeMonths Int? @map("min_age_months") @db.SmallInt
  maxAgeMonths Int? @map("max_age_months") @db.SmallInt

  parentId String?     @map("parent_id") @db.Uuid
  parent   AnimalType? @relation("AnimalTypeHierarchy", fields: [parentId], references: [id], onDelete: Restrict)

  // Hierarchy
  children AnimalType[] @relation("AnimalTypeHierarchy")

  // Animals
  animals Animal[]

  // Urine Analysis Types
  urineColors        UrineColor[]
  urineSmells        UrineSmell[]
  urineClarities     UrineClarity[]
  urineConsistencies UrineConsistency[]

  // Feces Analysis Types
  fecesColors        FecesColor[]
  fecesSmells        FecesSmell[]
  fecesConsistencies FecesConsistency[]
  fecesForms         FecesForm[]

  // Mucosa Analysis Types
  mucosaAppearances MucosaAppearance[]

  // Anomaly Detection
  referenceRanges ReferenceRange[]

  @@index([parentId])
  @@index([sexId])
  @@map("animal_types")
}

model Breed {
  id String @id @default(uuid()) @db.Uuid

  name Json @db.JsonB

  animals Animal[]

  @@map("animal_breeds")
}

model Color {
  id String @id @default(uuid()) @db.Uuid

  name Json @db.JsonB

  animals Animal[]

  @@map("animal_colors")
}
