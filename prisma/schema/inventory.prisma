
enum AnimalSex {
  MALE // erkak
  FEMALE // ayol
  NEUTERED // kastratsiya qilingan erkak
  SPAYED // sterilizatsiya qilingan ayol
  UNKNOWN // noma'lum
}

model Animal {
  id String @id @default(uuid()) @db.Uuid

  arrivalDate DateTime @map("arrival_date")

  age Int       @db.SmallInt
  sex AnimalSex @default(UNKNOWN)

  animalNameCode String @unique @map("animal_name_code") @db.VarChar(50)
  // weight Float

  farmerId String? @map("farmer_id") @db.Uuid
  farmer   FarmerProfile? @relation(fields: [farmerId], references: [id], onDelete: Restrict)

  animalTypeId String     @map("animal_type_id") @db.Uuid
  animalType   AnimalType @relation(fields: [animalTypeId], references: [id], onDelete: Restrict)

  animalBreedId String      @map("animal_breed_id") @db.Uuid
  animalBreed   Breed @relation(fields: [animalBreedId], references: [id], onDelete: Restrict)

  animalColorId String      @map("color_id") @db.Uuid
  animalColor   Color @relation(fields: [animalColorId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  vaccines Prophylaxis[]
  diseases Disease[]
  urineAnalyses UrineExam[]
  fecesAnalyses FecesExam[]
  mucosaAnalyses MucosaExam[]
  bloodAnalyses BloodExam[]
  clinicalAnalyses ClinicalExam[]

  @@index([farmerId])
  @@index([animalTypeId])
  @@index([animalBreedId])
  @@index([sex])
  @@map("animals")
}

model AnimalType {
  id String @id @default(uuid()) @db.Uuid

  name_ru String @unique @db.VarChar(255)
  name_uz String @unique @db.VarChar(255)

  parentId String?     @map("parent_id") @db.Uuid
  parent   AnimalType? @relation("AnimalTypeHierarchy", fields: [parentId], references: [id], onDelete: Restrict)

  // Hierarchy
  children AnimalType[] @relation("AnimalTypeHierarchy")

  // Animals
  animals Animal[]

  // Breeds
  breeds Breed[]

  // Urine Analysis Types
  urineColors        UrineColor[]
  urineSmells        UrineSmell[]
  urineClarities     UrineClarity[]
  urineConsistencies UrineConsistency[]

  // Feces Analysis Types
  fecesColors        FecesColor[]
  fecesSmells        FecesSmell[]
  fecesConsistencies FecesConsistency[]
  fecesForms         FecesForm[]

  // Mucosa Analysis Types
  mucosaAppearances MucosaAppearance[]

  @@index([parentId])
  @@map("animal_types")
}

model Breed {
  id String @id @default(uuid()) @db.Uuid

  name_ru String @db.VarChar(255)
  name_uz String @db.VarChar(255)

  animalTypeId String     @map("animal_type_id") @db.Uuid
  animalType   AnimalType @relation(fields: [animalTypeId], references: [id], onDelete: Restrict)

  animals Animal[]

  @@index([animalTypeId])
  @@map("animal_breeds")
}

model Color {
  id String @id @default(uuid()) @db.Uuid

  name_ru String @db.VarChar(50)
  name_uz String @db.VarChar(50)

  animals Animal[]

  @@map("animal_colors")
}
