meta {
  name: Create Prophylaxis Item
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/prophylaxis-items
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": { "ru": "Вакцина против бруцеллёза", "uz": "Brucella vaksina" },
    "type": "VACCINE"
  }
}

docs {
  # Create Prophylaxis Item

  Creates a new prophylaxis item (vaccine or drug reference data).
  Both Russian and Uzbek names are required (bilingual).
}

tests {
  test("Status 201", function() {
    expect(res.status).to.equal(201);
  });
  test("Has id", function() {
    expect(res.body.data).to.have.property("id");
    bru.setVar("prophylaxisItemId", res.body.data.id);
  });
}
