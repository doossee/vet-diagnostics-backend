meta {
  name: Get Prophylaxis Item
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/prophylaxis-items/{{prophylaxisItemId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  # Get Prophylaxis Item

  Returns a single prophylaxis item by ID.
  Requires authentication.

  ## Path Parameters
  - `prophylaxisItemId` — UUID of the prophylaxis item
}

tests {
