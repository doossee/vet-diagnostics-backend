meta {
  name: Get Disease
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/diseases/{{diseaseId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  # Get Disease

  Returns a single disease by ID.
  Requires authentication.

  ## Path Parameters
  - `diseaseId` — UUID of the disease
}

