meta {
  name: List Disease Categories
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/disease-categories?page=1&perPage=10
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  # List Disease Categories

  Returns a paginated list of disease categories.
  Requires authentication.

  ## Query Parameters
  - `page` — Page number (default: 1)
  - `perPage` — Items per page (default: 10)
}

tests {
  test("Status is 200", function() {
    expect(res.status).to.equal(200);
  });
  test("Data is array", function() {
    expect(res.body.data).to.be.an("array");
  });
}
