meta {
  name: Update Prophylaxis
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/prophylaxis/{{prophylaxisId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "notes": "Updated notes",
    "nextDate": "2025-06-01"
  }
}

docs {
  # Update Prophylaxis

  Updates an existing prophylaxis record by ID.
  Requires authentication.

  ## Path Parameters
  - `prophylaxisId` — UUID of the prophylaxis record

  ## Fields
  - `notes` — Updated notes about the administration
  - `nextDate` — Updated scheduled date for the next dose (YYYY-MM-DD)
}

tests {
  test("Status is 200", function() {
    expect(res.status).to.equal(200);
  });
}
