meta {
  name: List Prophylaxis
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/prophylaxis?page=1&perPage=10
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  # List Prophylaxis

  Returns a paginated list of prophylaxis records.
  Requires authentication.

  ## Query Parameters
  - `page` — Page number (default: 1)
  - `perPage` — Items per page (default: 10)
}

tests {
  test("Status is 200", function() {
    expect(res.status).to.equal(200);
  });
}
