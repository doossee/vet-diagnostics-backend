meta {
  name: Create Prophylaxis
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/prophylaxis
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "animalId": "{{animalId}}",
    "itemId": "{{prophylaxisItemId}}",
    "detailId": "{{prophylaxisDetailId}}",
    "date": "2024-03-01",
    "dose": "5ml",
    "notes": "First vaccination",
    "nextDate": "2025-03-01"
  }
}

docs {
  # Create Prophylaxis

  Creates a new prophylaxis record for an animal.
  Requires authentication.

  ## Fields
  - `animalId` — UUID of the animal receiving the prophylaxis
  - `itemId` — UUID of the prophylaxis item (vaccine/drug)
  - `detailId` — UUID of the prophylaxis detail (strain/sub-type)
  - `date` — Date the prophylaxis was administered (YYYY-MM-DD)
  - `dose` — Dosage administered (e.g. "5ml")
  - `notes` — Optional notes about the administration
  - `nextDate` — Scheduled date for the next dose (YYYY-MM-DD)
}

tests {
  test("Status is 201", function() {
    expect(res.status).to.equal(201);
  });
  test("Returns prophylaxis id", function() {
    expect(res.body.data).to.have.property("id");
    bru.setVar("prophylaxisId", res.body.data.id);
  });
}
