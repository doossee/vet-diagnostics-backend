  token: {{accessToken}}
}

docs {
  # Delete Prophylaxis Detail

  Deletes a prophylaxis detail (strain/sub-type) by ID.
  Requires authentication.

  ## Path Parameters
  - `prophylaxisDetailId` — UUID of the prophylaxis detail to delete
}

