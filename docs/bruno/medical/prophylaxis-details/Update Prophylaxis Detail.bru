meta {
  name: Update Prophylaxis Detail
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/prophylaxis-details/{{prophylaxisDetailId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": {
      "ru": "P52",
      "uz": "P52"
    }
  }
}

docs {
  # Update Prophylaxis Detail

  Updates an existing prophylaxis detail (strain/sub-type) by ID.
  Requires authentication.

  ## Path Parameters
  - `prophylaxisDetailId` — UUID of the prophylaxis detail

  ## Fields
  - `name.ru` — Updated detail name in Russian
  - `name.uz` — Updated detail name in Uzbek
}

tests {
  test("Status is 200", function() {
    expect(res.status).to.equal(200);
  });
}
