meta {
  name: Get Prophylaxis Detail
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/prophylaxis-details/{{prophylaxisDetailId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  # Get Prophylaxis Detail

  Returns a single prophylaxis detail (strain/sub-type) by ID.
  Requires authentication.

  ## Path Parameters
  - `prophylaxisDetailId` — UUID of the prophylaxis detail
}

tests {
