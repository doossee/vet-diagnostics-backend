meta {
  name: List Prophylaxis Details
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/prophylaxis-details?page=1&perPage=20
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  # List Prophylaxis Details

  Returns a paginated list of prophylaxis details (strains/sub-types).
  Requires authentication.

  ## Query Parameters
  - `page` — Page number (default: 1)
  - `perPage` — Items per page (default: 20)
}

tests {
  test("Status is 200", function() {
    expect(res.status).to.equal(200);
  });
}
