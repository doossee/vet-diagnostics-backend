meta {
  name: List Breeds
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/breeds?page=1&perPage=20
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  # List Breeds

  Returns a paginated list of all animal breeds.

  ## Query Parameters
  - `page` — Page number (default: 1)
  - `perPage` — Items per page (default: 10)
  - `search` — Search in bilingual name
}

tests {
  test("Status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("Data is array", function() {
    expect(res.body.data).to.be.an("array");
  });
}
