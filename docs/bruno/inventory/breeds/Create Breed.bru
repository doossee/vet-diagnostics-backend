meta {
  name: Create Breed
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/breeds
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": {
      "ru": "Голштинская порода",
      "uz": "Holstein"
    }
  }
}

docs {
  # Create Breed

  Creates a new animal breed entry with a bilingual name.

  **Required fields:**
  - `name` — bilingual name object with `ru` and `uz` keys
}

tests {
  test("Status is 201", function() {
    expect(res.status).to.equal(201);
  });
  test("Returns id", function() {
    expect(res.body.data).to.have.property("id");
    bru.setVar("breedId", res.body.data.id);
  });
}
