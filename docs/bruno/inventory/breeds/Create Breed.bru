meta {
  name: Create Breed
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/breeds
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "name": { "ru": "Голштинская порода", "uz": "Holstein" }
  }
}

docs {
  # Create Breed

  Creates a new animal breed entry with a bilingual name.

  ## Request Body
  - `name` — bilingual name object `{ "ru": "...", "uz": "..." }`
}

tests {
  test("Status 201", function() {
    expect(res.status).to.equal(201);
  });
  test("Save breedId", function() {
    const id = res.body.data?.id;
    expect(id).to.be.a("string");
    bru.setVar("breedId", id);
  });
}
