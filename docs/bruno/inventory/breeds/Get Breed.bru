get {
  url: {{baseUrl}}/breeds/{{breedId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  # Get Breed

  Returns a single breed by its ID.

  **Path parameters:**
  - `breedId` — UUID of the breed
}

tests {
