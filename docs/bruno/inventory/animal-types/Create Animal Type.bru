meta {
  name: Create Animal Type
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/animal-types
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": { "ru": "Новый тип", "uz": "Yangi tur" },
    "parentId": null
  }
}

docs {
  # Create Animal Type

  Creates a new animal type node in the hierarchy.

  The animal type tree is structured as a parent-child hierarchy. Currently only cattle
  subtypes are AI-model-ready. The four leaf types that feed into the ML pipeline are:
  - **Buqa** (Bull) — adult male
  - **G'unojin** (Heifer) — young female
  - **Sigir** (Cow) — adult female
  - **Buzoq** (Calf) — young animal

  Setting `parentId` to `null` creates a root-level type. Set `parentId` to an existing
  type's ID to create a child node.

  **Required fields:**
  - `name` — bilingual name object with `ru` and `uz` keys

  **Optional fields:**
  - `parentId` — ID of the parent animal type (null for top-level)
}

tests {
  test("Status is 201", function() {
    expect(res.status).to.equal(201);
  });
  test("Returns id", function() {
    expect(res.body.data).to.have.property("id");
    bru.setVar("animalTypeId", res.body.data.id);
  });
}
