meta {
  name: Create Animal Type
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/animal-types
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "name": { "ru": "Новый тип", "uz": "Yangi tur" },
    "parentId": null
  }
}

docs {
  # Create Animal Type

  Creates a new animal type node in the hierarchy.

  Note: Currently only the four cattle leaf subtypes are AI-model-ready (they have a `modelKey`
  and `featureValue` assigned and feed into the ML prediction pipeline):
  - **Buqa** — adult bull (male, >= 3 years)
  - **G'unojin** — heifer (female, < 3 years)
  - **Sigir** — cow (female, >= 3 years)
  - **Buzoq** — calf (< 1 year, either sex)

  New types created here will not be usable by the ML prediction pipeline until a `modelKey`
  and `featureValue` are assigned manually.

  ## Request Body
  - `name` — bilingual name object `{ "ru": "...", "uz": "..." }`
  - `parentId` — UUID of parent animal type, or `null` for root-level types
}

tests {
  test("Status 201", function() {
    expect(res.status).to.equal(201);
  });
  test("Save animalTypeId", function() {
    const id = res.body.data?.id;
    expect(id).to.be.a("string");
    bru.setVar("animalTypeId", id);
  });
}
