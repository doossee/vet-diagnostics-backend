meta {
  name: Update Animal Type
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/animal-types/{{animalTypeId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "name": { "ru": "Обновлённый тип", "uz": "Yangilangan tur" }
  }
}

docs {
  # Update Animal Type

  Partially updates an existing animal type. All fields are optional — only provided fields
  are updated.

  ## Path Parameters
  - `animalTypeId` — UUID of the animal type to update

  ## Updatable Fields
  - `name` — bilingual name object `{ "ru": "...", "uz": "..." }`
  - `parentId` — parent animal type UUID
  - `modelKey` — ML model key string
}

tests {
  test("Status 200", function() {
    expect(res.status).to.equal(200);
  });
}
