meta {
  name: Delete Animal Type
  type: http
  seq: 6
}

delete {
  url: {{baseUrl}}/animal-types/{{animalTypeId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  # Delete Animal Type

  Deletes an animal type by its ID.

  ## Path Parameters
  - `animalTypeId` — UUID of the animal type to delete

  **Note:** Deleting a parent type that has child subtypes or animals referencing it may result
  in a constraint error (Prisma P2003). Remove or reassign children first.
}

tests {
  test("Status 200", function() {
    expect(res.status).to.equal(200);
  });
}
