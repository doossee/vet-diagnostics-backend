meta {
  name: Create Animal Sex
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/animal-sexes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "name": {
      "ru": "Самец",
      "uz": "Erkak"
    },
    "numericValue": 1
  }
}

tests {
  test("Status 201", function() {
    expect(res.status).to.equal(201);
  });
  test("Save animalSexId", function() {
    const id = res.body.data?.id;
    expect(id).to.be.a("string");
    bru.setVar("animalSexId", id);
  });
}
