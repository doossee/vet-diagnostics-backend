meta {
  name: Create Color
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/colors
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "name": { "ru": "Белый", "uz": "Oq" }
  }
}

docs {
  # Create Color

  Creates a new animal coat color entry with a bilingual name.

  ## Request Body
  - `name` — bilingual name object `{ "ru": "...", "uz": "..." }`
}

tests {
  test("Status 201", function() {
    expect(res.status).to.equal(201);
  });
  test("Save colorId", function() {
    const id = res.body.data?.id;
    expect(id).to.be.a("string");
    bru.setVar("colorId", id);
  });
}
