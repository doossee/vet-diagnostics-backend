meta {
  name: List Colors
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/colors?page=1&perPage=20
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  # List Colors

  Returns a paginated list of all animal coat colors.

  **Query parameters:**
  - `page` — page number (default: 1)
  - `perPage` — items per page (default: 20)
  - `search` — optional search string matched against bilingual name fields
}

tests {
  test("Status is 200", function() {
    expect(res.status).to.equal(200);
  });
  test("Data is array", function() {
    expect(res.body.data).to.be.an("array");
  });
}
