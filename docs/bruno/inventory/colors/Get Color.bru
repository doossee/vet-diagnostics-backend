meta {
  name: Get Color
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/colors/{{colorId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  # Get Color

  Returns a single coat color by its ID.

  ## Path Parameters
  - `colorId` — UUID of the color
}

tests {
