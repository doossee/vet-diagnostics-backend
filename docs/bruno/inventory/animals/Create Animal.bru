meta {
  name: Create Animal
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/animals
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "arrivalDate": "2024-01-15",
    "animalNameCode": "COW-001",
    "birthYear": 2021,
    "birthMonth": 3,
    "sexId": "{{sexId}}",
    "farmerId": "{{farmerId}}",
    "animalTypeId": "{{animalTypeId}}",
    "animalBreedId": "{{breedId}}",
    "animalColorId": "{{colorId}}"
  }
}

docs {
  # Create Animal

  Registers a new animal in the inventory.

  `animalTypeId` should be one of the 4 cattle leaf types (Buqa, G'unojin, Sigir, Buzoq).
  Use the **Resolve Animal Type** endpoint first to determine the correct leaf UUID from the
  parent type ID, `birthYear`, and `birthMonth`.

  ## Request Body
  - `arrivalDate` — ISO date string (YYYY-MM-DD) when the animal arrived
  - `animalNameCode` — unique identifier code for the animal (e.g. COW-001)
  - `birthYear` — four-digit birth year
  - `birthMonth` — birth month (1–12); used together with `birthYear` to auto-resolve type from parent
  - `sexId` — UUID of the sex reference value
  - `farmerId` — UUID of the farmer who owns the animal
  - `animalTypeId` — UUID of the resolved leaf AnimalType (one of the 4 cattle subtypes)
  - `animalBreedId` — UUID of the animal breed
  - `animalColorId` — UUID of the animal coat color
}

tests {
  test("Status 201", function() {
    expect(res.status).to.equal(201);
  });
  test("Save animalId", function() {
    const id = res.body.data?.id;
    expect(id).to.be.a("string");
    bru.setVar("animalId", id);
  });
}
