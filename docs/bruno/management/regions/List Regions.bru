meta {
  name: List Regions
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/regions?page=1&perPage=10
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  # List Regions

  Returns a paginated list of regions. Requires admin access.

  ## Query Parameters
  - `page` — Page number (default: 1)
  - `perPage` — Items per page (default: 10)
  - `search` — Optional search string

  ## Response
  Returns paginated `RegionEntity[]` with meta.
}

tests {
  test("Status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("Data is array", function() {
    expect(res.body.data).to.be.an("array");
  });
  test("Has meta.total", function() {
    expect(res.body.meta).to.have.property("total");
  });
}
