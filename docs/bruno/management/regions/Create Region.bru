meta {
  name: Create Region
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/regions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": { "ru": "Ташкент", "uz": "Toshkent" }
  }
}

docs {
  # Create Region

  Creates a new region. Requires admin access.

  ## Request Body
  - `name.ru` — Region name in Russian
  - `name.uz` — Region name in Uzbek

  ## Response
  Returns the created `RegionEntity`.
}

tests {
  test("Status 201", function() {
    expect(res.status).to.equal(201);
  });
  test("Has id", function() {
    expect(res.body.data).to.have.property("id");
    bru.setVar("regionId", res.body.data.id);
  });
}
