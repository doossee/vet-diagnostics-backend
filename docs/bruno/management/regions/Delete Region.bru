delete {
  url: {{baseUrl}}/regions/{{regionId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  # Delete Region

  Deletes a region by ID. Requires admin access.

  ## Path Parameters
  - `id` — Region UUID

  ## Response
  Returns the deleted `RegionEntity`.
}

