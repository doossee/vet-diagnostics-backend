meta {
  name: Get Vet Station
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/vet-stations/{{vetStationId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  # Get Vet Station

  Returns a single veterinary station by ID. Requires admin access.

  ## Path Parameters
  - `id` — Vet station UUID

  ## Response
  Returns the `VetStationEntity`.
}

tests {
  test("Status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("Has id", function() {
    expect(res.body.data).to.have.property("id");
  });
}
