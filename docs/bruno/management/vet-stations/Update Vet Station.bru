meta {
  name: Update Vet Station
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/vet-stations/{{vetStationId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": { "ru": "Ветеринарная станция Юнусабад", "uz": "Yunusobod veterinariya stansiyasi" }
  }
}

docs {
  # Update Vet Station

  Updates an existing veterinary station by ID. Requires admin access.

  ## Path Parameters
  - `id` — Vet station UUID

  ## Request Body
  - `name.ru` — Vet station name in Russian
  - `name.uz` — Vet station name in Uzbek

  ## Response
  Returns the updated `VetStationEntity`.
}

tests {
  test("Status 200", function() {
    expect(res.status).to.equal(200);
  });
}
