delete {
  url: {{baseUrl}}/districts/{{districtId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  # Delete District

  Deletes a district by ID. Requires admin access.

  ## Path Parameters
  - `id` — District UUID

  ## Response
  Returns the deleted `DistrictEntity`.
}

