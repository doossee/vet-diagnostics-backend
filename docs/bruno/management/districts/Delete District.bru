meta {
  name: Delete District
  type: http
  seq: 5
}

delete {
  url: {{baseUrl}}/districts/{{districtId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  # Delete District

  Deletes an existing district by its ID. Requires admin access.

  ## Path Parameters
  - `districtId` — The ID of the district to delete

  ## Response
  Returns a confirmation message wrapped in `{ data: ..., message: "..." }`.
}

tests {
  test("Status 200", function() {
    expect(res.status).to.equal(200);
  });
}
