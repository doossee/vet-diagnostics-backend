meta {
  name: Create District
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/districts
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": { "ru": "Юнусабад", "uz": "Yunusobod" },
    "regionId": "{{regionId}}"
  }
}

docs {
  # Create District

  Creates a new district. Requires admin access.

  ## Request Body
  - `name.ru` — District name in Russian
  - `name.uz` — District name in Uzbek
  - `regionId` — UUID of the parent region

  ## Response
  Returns the created `DistrictEntity`.
}

tests {
  test("Status 201", function() {
    expect(res.status).to.equal(201);
  });
  test("Has id", function() {
    expect(res.body.data).to.have.property("id");
    bru.setVar("districtId", res.body.data.id);
  });
}
