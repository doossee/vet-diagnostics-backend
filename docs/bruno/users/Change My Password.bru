meta {
  name: Change My Password
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/users/me/change-password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "currentPassword": "123qazwsx",
    "newPassword": "newpassword123"
  }
}

docs {
  # Change My Password

  Change the password for the currently authenticated user. Requires the current password for verification.

  Requires a valid accessToken as a Bearer token.
}

tests {
  test("Status 200", function() {
    expect(res.status).to.equal(200);
  });
}
