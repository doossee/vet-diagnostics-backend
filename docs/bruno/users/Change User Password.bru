meta {
  name: Change User Password
  type: http
  seq: 9
}

patch {
  url: {{baseUrl}}/users/{{userId}}/change-password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "currentPassword": "password123",
    "newPassword": "newpassword456"
  }
}

docs {
  # Change User Password

  Change the password of a specific user by their UUID. Admin-only endpoint. Requires the user's current password for verification.

  Requires a valid accessToken with ADMIN or SUPER_ADMIN role.

  ## Path Parameter
  - `userId` — UUID of the user whose password will be changed (saved by the Create User request)

  ## Request Body
  - `currentPassword` — the user's existing password
  - `newPassword` — the desired new password
}

tests {
  test("Status 200", function() {
    expect(res.status).to.equal(200);
  });
}
