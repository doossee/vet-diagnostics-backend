meta {
  name: Health Check
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/health
  body: none
  auth: none
}

docs {
  # Health Check

  Verify that the API server is running and healthy. This endpoint is public and requires no authentication.

  ## Response
  - `data.status` — "ok" when all services are operational
}

tests {
  test("Status 200", function() {
    expect(res.status).to.equal(200);
  });

  test("data.status is ok", function() {
    expect(res.body.data.status).to.equal("ok");
  });
}
