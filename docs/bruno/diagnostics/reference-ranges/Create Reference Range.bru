meta {
  name: Create Reference Range
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/reference-ranges
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "parameterName": "hemoglobin",
    "animalTypeId": "{{animalTypeId}}",
    "minValue": 80,
    "maxValue": 140
  }
}

tests {
  test("Status 201", function() {
    expect(res.status).to.equal(201);
  });

  test("Save referenceRangeId", function() {
    bru.setVar("referenceRangeId", res.body.data.id);
  });
}
