meta {
  name: Create Feces Color
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/feces-colors
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "name": {
      "ru": "Коричневый",
      "uz": "Jigarrang"
    },
    "numericValue": 1
  }
}

tests {
  test("Status 201", function() {
    expect(res.status).to.equal(201);
  });
  test("Save fecesColorId", function() {
    const id = res.body.data?.id;
    expect(id).to.be.a("string");
    bru.setVar("fecesColorId", id);
  });
}
