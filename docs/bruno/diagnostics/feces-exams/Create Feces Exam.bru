meta {
  name: Create Feces Exam
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/feces-exams
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "animalId": "{{animalId}}",
    "sessionId": "{{sessionId}}",
    "fecesColorId": "{{fecesColorId}}",
    "fecesSmellId": "{{fecesSmellId}}",
    "fecesConsistencyId": "{{fecesConsistencyId}}",
    "fecesFormId": "{{fecesFormId}}",
    "amount": 15.0,
    "undigestedFood": false
  }
}

tests {
  test("Status 201", function() {
    expect(res.status).to.equal(201);
  });

  test("Save fecesExamId", function() {
    bru.setVar("fecesExamId", res.body.data.id);
  });
}
