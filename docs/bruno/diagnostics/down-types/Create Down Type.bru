meta {
  name: Create Down Type
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/down-types
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "name": {
      "ru": "Густой",
      "uz": "Qalin"
    },
    "numericValue": 1
  }
}

tests {
  test("Status 201", function() {
    expect(res.status).to.equal(201);
  });
  test("Save downTypeId", function() {
    const id = res.body.data?.id;
    expect(id).to.be.a("string");
    bru.setVar("downTypeId", id);
  });
}
