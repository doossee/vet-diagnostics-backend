meta {
  name: Create Skin Humidity
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/skin-humidities
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "name": {
      "ru": "Умеренная",
      "uz": "Mo''tadil"
    },
    "numericValue": 1
  }
}

tests {
  test("Status 201", function() {
    expect(res.status).to.equal(201);
  });
  test("Save skinHumidityId", function() {
    const id = res.body.data?.id;
    expect(id).to.be.a("string");
    bru.setVar("skinHumidityId", id);
  });
}
