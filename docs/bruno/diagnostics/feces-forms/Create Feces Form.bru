meta {
  name: Create Feces Form
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/feces-forms
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "name": {
      "ru": "Оформленный",
      "uz": "Shakllangan"
    },
    "numericValue": 1
  }
}

tests {
  test("Status 201", function() {
    expect(res.status).to.equal(201);
  });
  test("Save fecesFormId", function() {
    const id = res.body.data?.id;
    expect(id).to.be.a("string");
    bru.setVar("fecesFormId", id);
  });
}
