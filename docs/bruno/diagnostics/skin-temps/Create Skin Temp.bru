meta {
  name: Create Skin Temp
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/skin-temps
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "name": {
      "ru": "Нормальная",
      "uz": "Normal"
    },
    "numericValue": 1
  }
}

tests {
  test("Status 201", function() {
    expect(res.status).to.equal(201);
  });
  test("Save skinTempId", function() {
    const id = res.body.data?.id;
    expect(id).to.be.a("string");
    bru.setVar("skinTempId", id);
  });
}
