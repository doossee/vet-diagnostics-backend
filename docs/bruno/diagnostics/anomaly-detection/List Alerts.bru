meta {
  name: List Alerts
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/anomaly-detection/alerts?animalId={{animalId}}&page=1&perPage=10
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("Status 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Has meta", function() {
    expect(res.body.data).to.have.property("meta");
  });
}
