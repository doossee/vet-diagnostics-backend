meta {
  name: Create Mucosa Appearance
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/mucosa-appearances
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "name": {
      "ru": "Бледно-розовая",
      "uz": "Och pushti"
    },
    "numericValue": 1
  }
}

tests {
  test("Status 201", function() {
    expect(res.status).to.equal(201);
  });
  test("Save mucosaAppearanceId", function() {
    const id = res.body.data?.id;
    expect(id).to.be.a("string");
    bru.setVar("mucosaAppearanceId", id);
  });
}
