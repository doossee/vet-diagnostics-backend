meta {
  name: Create Urine Clarity
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/urine-clarities
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "name": {
      "ru": "Прозрачная",
      "uz": "Tiniq"
    },
    "numericValue": 1
  }
}

tests {
  test("Status 201", function() {
    expect(res.status).to.equal(201);
  });
  test("Save urineClarityId", function() {
    const id = res.body.data?.id;
    expect(id).to.be.a("string");
    bru.setVar("urineClarityId", id);
  });
}
