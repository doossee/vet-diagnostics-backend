meta {
  name: Create Skin Elasticity
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/skin-elasticities
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "name": {
      "ru": "Эластичная",
      "uz": "Elastik"
    },
    "numericValue": 1
  }
}

tests {
  test("Status 201", function() {
    expect(res.status).to.equal(201);
  });
  test("Save skinElasticityId", function() {
    const id = res.body.data?.id;
    expect(id).to.be.a("string");
    bru.setVar("skinElasticityId", id);
  });
}
